# Neon Postgres connection string (pooled)
DATABASE_URL=
# Resend API key. Leave empty to print emails to the server console instead of sending.
RESEND_API_KEY=
# Sender. Must be on a domain verified in Resend to reach anyone but your own Resend login address.
EMAIL_FROM="IF / THEN <hello@your-domain.com>"
# Public URL of the site, used in email links
APP_URL=http://localhost:3000
# 32+ random characters each
SESSION_SECRET=
CRON_SECRET=
# Password for /admin
ADMIN_PASSWORD=
# Address that receives admin test sends
ADMIN_EMAIL=
